# Copy to .env and replace every placeholder. Never commit .env.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Application database. PostgreSQL 14 or later.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=bajogo_app
DB_PASSWORD=change-me
DB_NAME=bajogo_erp

# The application user creates the database when it has the CREATEDB privilege.
DB_ADMIN_USER=bajogo_app
DB_ADMIN_PASSWORD=change-me

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Initial technical administrator. Leave the password blank to generate one.
SEED_ADMIN_USERNAME=sysadmin
SEED_ADMIN_EMAIL=sysadmin@bajogo.local
SEED_ADMIN_PASSWORD=

# Salary-paid SMS. "log" writes messages to the server log instead of sending them.
# Use "arkesel" or "hubtel" with that provider's keys. The sender ID must be approved by the provider (max 11 characters).
SMS_PROVIDER=log
SMS_SENDER_ID=BAJOGO
ARKESEL_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
