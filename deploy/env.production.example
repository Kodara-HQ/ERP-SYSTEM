# BAJOGO ERP — production settings.
# Copy to /srv/bajogo-erp/.env on the server, fill in every value, then:
#   chmod 600 /srv/bajogo-erp/.env

NODE_ENV=production
# Pick a port no other app on the server uses (check with: sudo ss -ltnp)
PORT=4100
HOST=127.0.0.1
CLIENT_ORIGIN=https://erp.example.com
TRUST_PROXY=true

# Public addresses, no trailing slash. The website links "Staff Login" to the ERP,
# and its sitemap.xml and robots.txt use the website address.
ERP_PUBLIC_URL=https://erp.example.com
WEBSITE_PUBLIC_URL=https://www.example.com

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bajogo_app
DB_PASSWORD=replace-with-the-password-from-postgres-setup
DB_NAME=bajogo_erp
DB_ADMIN_USER=bajogo_app
DB_ADMIN_PASSWORD=replace-with-the-password-from-postgres-setup

# Generate a new one on the server:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

SEED_ADMIN_USERNAME=sysadmin
SEED_ADMIN_EMAIL=sysadmin@example.com
SEED_ADMIN_PASSWORD=

# "log" only writes SMS to the server log. Use arkesel or hubtel to really send.
SMS_PROVIDER=log
SMS_SENDER_ID=BAJOGO
ARKESEL_API_KEY=
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
